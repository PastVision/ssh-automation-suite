# Application state — never commit
backend/data/
backend/logs/
# Root-level equivalents: relative paths anchor to backend/, but a stray manual
# run from the repository root would otherwise leave runtime state (and execution
# logs, which can contain host output) inside the tree.
/data/
/logs/
*.db
*.db-wal
*.db-shm
*.sqlite3
*.key
.env
.env.*
!.env.example

# Local scratch: dev server logs, acceptance runs, ad-hoc verification output
.devlogs/
.tmp-acceptance/
.tmp*/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
