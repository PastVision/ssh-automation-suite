# Copy to backend/.env and adjust. Every setting is optional; these are the
# defaults shown as the effective value.

# --- Core ---
SSHSUITE_ENVIRONMENT=development
SSHSUITE_DEBUG=false
SSHSUITE_LOG_LEVEL=INFO
SSHSUITE_API_PREFIX=/api

# --- Storage ---
# Relative paths resolve against the backend/ directory.
SSHSUITE_DATA_DIR=data
SSHSUITE_LOG_DIR=logs
# Optional; defaults to <data_dir>/ssh_suite.db
# SSHSUITE_DATABASE_URL=sqlite:///./data/ssh_suite.db

# --- Security ---
# Fernet key file for encrypting SSH private keys. Generated on first use.
# SSHSUITE_SECRET_KEY_FILE=data/secret.key

# --- Execution ---
SSHSUITE_MAX_CONCURRENT_HOST_WORKFLOWS=20
SSHSUITE_SHUTDOWN_GRACE_SECONDS=30
SSHSUITE_SCHEDULER_TIMEZONE=UTC

# --- SSH transport ---
SSHSUITE_SSH_CONNECT_TIMEOUT_SECONDS=15
SSHSUITE_SSH_COMMAND_TIMEOUT_SECONDS=300

# Host-key verification is ON by default (checked against ~/.ssh/known_hosts when
# this is unset). Point it at a managed trust store for real deployments.
# SSHSUITE_SSH_KNOWN_HOSTS_FILE=C:/Users/you/.ssh/known_hosts

# DANGER: disables host-key verification entirely. Only for the disposable Docker
# test lab. Rejected at startup when SSHSUITE_ENVIRONMENT=production.
# SSHSUITE_SSH_ALLOW_UNKNOWN_HOST_KEYS=false

# --- CORS (comma separated) ---
SSHSUITE_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
