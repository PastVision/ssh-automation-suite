# sshd configuration for every lab container.
#
# Complete and self-contained (not a drop-in for the distro defaults) so the
# behaviour cannot drift with a base image change.

Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# Host keys live on a per-container bind mount so they survive a restart.
# Generated by entrypoint.sh on first boot, unique per container.
HostKey /etc/ssh/lab-host-keys/ssh_host_ed25519_key
HostKey /etc/ssh/lab-host-keys/ssh_host_rsa_key

# Public-key authentication only.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey

PermitRootLogin no
AllowUsers tester
MaxAuthTries 3
MaxSessions 10
LoginGraceTime 20

AuthorizedKeysFile .ssh/authorized_keys
StrictModes yes
# PAM is unnecessary for public-key-only auth and adds privileges a minimal
# container does not need.
UsePAM no

ClientAliveInterval 30
ClientAliveCountMax 3

PrintMotd no
PermitUserEnvironment no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no

Subsystem sftp internal-sftp
PidFile /run/sshd/sshd.pid
LogLevel INFO
